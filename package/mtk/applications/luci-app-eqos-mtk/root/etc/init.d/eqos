#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=50
USE_PROCD=1

is_uinteger() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac

	return 0
}

validate_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 mac queue selector selector_count
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get mac "$cfg" mac
	config_get queue "$cfg" queue
	config_get selector "$cfg" selector
	[ -n "$queue" ] || config_get queue "$cfg" comment

	if ! is_uinteger "$queue" || [ "$queue" -lt 1 ]; then
		echo "eqos: $cfg queue slot must be a positive integer" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case " $USED_QUEUES " in
		*" $queue "*)
			echo "eqos: queue slot $queue is used by more than one rule" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_QUEUES="${USED_QUEUES}${queue} "

	selector_count=0
	[ -z "$ip" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))
	[ -z "$mac" ] || selector_count=$((selector_count + 1))

	if [ "$selector_count" -ne 1 ]; then
		echo "eqos: $cfg must set exactly one match field: ip, ip6, or mac" >&2
		CONFIG_ERROR=1
		return 0
	fi

	case "$selector" in
		''|ip|ip6|mac) ;;
		*)
			echo "eqos: $cfg selector must be ip, ip6, or mac" >&2
			CONFIG_ERROR=1
			return 0
			;;
	esac

	[ -z "$selector" ] && return 0
	[ "$selector" = ip ] && [ -n "$ip" ] && return 0
	[ "$selector" = ip6 ] && [ -n "$ip6" ] && return 0
	[ "$selector" = mac ] && [ -n "$mac" ] && return 0

	echo "eqos: $cfg selector does not match configured field" >&2
	CONFIG_ERROR=1
}

parse_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 mac download upload queue dev total_download total_upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get mac "$cfg" mac
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get queue "$cfg" queue
	config_get dev config dev br-lan
	config_get total_download config download
	config_get total_upload config upload
	[ -n "$queue" ] || config_get queue "$cfg" comment

	eqos add "$queue" "$download" "$upload" "$ip" "$ip6" "$mac" "$dev" \
		"$total_download" "$total_upload"
}

start_service() {
	config_load eqos

	local enabled
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	local download upload dev
	config_get download config download
	config_get upload config upload
	config_get dev config dev br-lan

	CONFIG_ERROR=0
	USED_QUEUES=" "
	config_foreach validate_device device
	[ "$CONFIG_ERROR" -eq 0 ] || return 1

	eqos start "$download" "$upload" "$dev" || return 1
	config_foreach parse_device device
}

stop_service() {
	local dev

	config_load eqos
	config_get dev config dev br-lan

	eqos stop "$dev"
}

reload_service() {
	stop_service
	start_service
}

service_triggers() {
	procd_add_reload_trigger eqos
}
