#!/bin/sh

DEV_DEFAULT="br-lan"
HNAT_DIR="/sys/kernel/debug/hnat"
NFT="/usr/sbin/nft"

TABLE_FAMILY="inet"
TABLE_NAME="eqos"
CHAIN_NAME="forward"
MARK_CLEAR_MASK="0xffff0000"
HNAT_EXCEPTION_MARK="0x99"
HNAT_BIND_THRESHOLD=5

QDMA_QUEUE_COUNT=64
UP_SCH=2
DL_SCH=3
UP_QID_BASE=1
DL_QID_BASE=32
QUEUE_SLOTS=31
TC_SLOT_MAX=65535
PPD_QID=63
MANAGED_QID_LAST=62
DEFAULT_QUEUE_CFG="0 1 10000 0 0 0 4"

die() {
	echo "eqos: $*" >&2
	exit 1
}

is_uinteger() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac

	return 0
}

valid_dev() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac

	return 0
}

valid_ipv4() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!0-9./]*) return 1 ;;
	esac

	return 0
}

valid_ipv6() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!0-9A-Fa-f:./]*) return 1 ;;
	esac

	return 0
}

valid_mac() {
	[ -n "$1" ] || return 1

	echo "$1" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}

need_nft() {
	[ -x "$NFT" ] || die "nftables is not available"
}

need_hnat() {
	[ -d "$HNAT_DIR" ] || insmod mtkhnat 2>/dev/null
	[ -d "$HNAT_DIR" ] || die "HNAT debugfs is not available"
}

write_hnat() {
	local node="$1"
	local value="$2"

	[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	printf '%s' "$value" > "$HNAT_DIR/$node"
}

need_qdma_layout() {
	need_hnat

	for node in qdma_sch0 qdma_sch1 qdma_sch$UP_SCH qdma_sch$DL_SCH \
		qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE qdma_txq$MANAGED_QID_LAST; do
		[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	done

	[ -e "$HNAT_DIR/qdma_txq0" ] ||
		die "qid0 is missing; expected $QDMA_QUEUE_COUNT-QDMA NETSYS layout"
	[ -e "$HNAT_DIR/qdma_txq$PPD_QID" ] ||
		die "qid$PPD_QID is missing; expected PPD-reserved queue"
}

stop_qos() {
	local dev="$1"

	tc qdisc del dev "$dev" root 2>/dev/null
	tc qdisc del dev "$dev" ingress 2>/dev/null
	tc qdisc del dev "${dev}-ifb" root 2>/dev/null
	ip link del dev "${dev}-ifb" 2>/dev/null
}

start_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"

	tc qdisc add dev "$dev" root handle 1: htb default 1 || return 1
	tc class add dev "$dev" parent 1: classid 1:1 htb rate "${dl}mbit" || return 1

	ip link add dev "${dev}-ifb" name "${dev}-ifb" type ifb || return 1
	ip link set dev "${dev}-ifb" up || return 1

	tc qdisc add dev "${dev}-ifb" root handle 1: htb default 1 || return 1
	tc class add dev "${dev}-ifb" parent 1: classid 1:1 htb rate "${up}mbit" || return 1

	tc qdisc add dev "$dev" ingress || return 1
	tc filter add dev "$dev" parent ffff: protocol ip u32 match u32 0 0 \
		flowid 1:1 action mirred egress redirect dev "${dev}-ifb" || return 1
	tc filter add dev "$dev" parent ffff: protocol ipv6 u32 match u32 0 0 \
		flowid 1:1 action mirred egress redirect dev "${dev}-ifb" || return 1
}

nft_stop() {
	need_nft
	"$NFT" delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null
}

nft_start() {
	local dev="$1"

	need_nft
	nft_stop

	"$NFT" -f - <<EOF || return 1
table $TABLE_FAMILY $TABLE_NAME {
	chain $CHAIN_NAME {
		type filter hook forward priority mangle; policy accept;
	}
}
EOF

	"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
		iifname "$dev" meta mark != "$HNAT_EXCEPTION_MARK" \
		meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
	"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
		oifname "$dev" meta mark != "$HNAT_EXCEPTION_MARK" \
		meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
}

reset_hnat_qdma() {
	local i

	need_qdma_layout
	i=0
	while [ "$i" -le 3 ]; do
		write_hnat "qdma_sch$i" "0 wrr 0"
		i=$((i + 1))
	done

	i=$UP_QID_BASE
	while [ "$i" -le "$MANAGED_QID_LAST" ]; do
		write_hnat "qdma_txq$i" "$DEFAULT_QUEUE_CFG"
		i=$((i + 1))
	done
}

start_hnat_qos() {
	local dl="$1"
	local up="$2"

	need_qdma_layout
	printf '%s' 1 > "$HNAT_DIR/qos_toggle"
	reset_hnat_qdma
	write_hnat "qdma_sch$UP_SCH" "1 wrr $((up * 1000))"
	write_hnat "qdma_sch$DL_SCH" "1 wrr $((dl * 1000))"
}

stop_hnat_qos() {
	[ -d "$HNAT_DIR" ] || return 0

	need_qdma_layout
	printf '%s' 0 > "$HNAT_DIR/qos_toggle"
	reset_hnat_qdma
}

set_hnat_bind_threshold() {
	write_hnat "hnat_setting" "1 $HNAT_BIND_THRESHOLD"

	[ -f /etc/config/turboacc ] || return 0

	if ! uci -q set "turboacc.config.fastpath_mh_bind_rate=$HNAT_BIND_THRESHOLD" ||
	   ! uci -q commit turboacc; then
		echo "eqos: failed to save turboacc bind rate" >&2
	fi
}

queue_from_slot() {
	local slot="$1"
	local dir="$2"

	case "$dir" in
		up) echo $((UP_QID_BASE + slot - 1)) ;;
		dl) echo $((DL_QID_BASE + slot - 1)) ;;
	esac
}

tc_classid_from_slot() {
	printf '%x\n' "$1"
}

ensure_tc_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"

	is_uinteger "$dl" || dl="$(uci -q get eqos.config.download)"
	is_uinteger "$up" || up="$(uci -q get eqos.config.upload)"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:" &&
	   [ -d "/sys/class/net/${dev}-ifb" ]; then
		return 0
	fi

	stop_qos "$dev"
	start_qos "$dev" "$dl" "$up"
}

program_queue() {
	local qid="$1"
	local sch="$2"
	local rate="$3"

	[ "$rate" -eq 0 ] && return 0
	write_hnat "qdma_txq$qid" "$sch 0 0 1 $rate 4 1"
}

tc_filter_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local classid="$4"
	local dev="$5"
	local tcdev key

	[ -n "$value" ] || return 0

	case "$dir" in
		up)
			tcdev="${dev}-ifb"
			key="src"
			;;
		dl)
			tcdev="$dev"
			key="dst"
			;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			tc filter add dev "$tcdev" parent 1: protocol ip u32 \
				match ip "$key" "$value" flowid "1:$classid"
			;;
		ip6)
			tc filter add dev "$tcdev" parent 1: protocol ipv6 u32 \
				match ip6 "$key" "$value" flowid "1:$classid"
			;;
		*)
			return 1
			;;
	esac
}

program_tc_queue() {
	local dir="$1"
	local slot="$2"
	local rate="$3"
	local ip4="$4"
	local ip6="$5"
	local dev="$6"
	local classid tcdev

	[ "$rate" -eq 0 ] && return 0
	[ -n "$ip4$ip6" ] ||
		die "software tc queue requires an IPv4 or IPv6 selector"

	case "$dir" in
		up) tcdev="${dev}-ifb" ;;
		dl) tcdev="$dev" ;;
		*) return 1 ;;
	esac

	classid="$(tc_classid_from_slot "$slot")"
	tc class replace dev "$tcdev" parent 1:1 classid "1:$classid" \
		htb rate "${rate}kbit" ceil "${rate}kbit" || return 1
	tc_filter_rule "$dir" ip "$ip4" "$classid" "$dev" || return 1
	tc_filter_rule "$dir" ip6 "$ip6" "$classid" "$dev" || return 1
}

nft_mark_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local qid="$4"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark != "$HNAT_EXCEPTION_MARK" \
				meta mark set "$qid"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark != "$HNAT_EXCEPTION_MARK" \
				meta mark set "$qid"
			;;
		ether)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ether "$addr" "$value" \
				meta mark != "$HNAT_EXCEPTION_MARK" \
				meta mark set "$qid"
			;;
		*)
			return 1
			;;
	esac
}

nft_exception_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark set "$HNAT_EXCEPTION_MARK"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark set "$HNAT_EXCEPTION_MARK"
			;;
		ether)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ether "$addr" "$value" \
				meta mark set "$HNAT_EXCEPTION_MARK"
			;;
		*)
			return 1
			;;
	esac
}

add_rule() {
	local slot="$1"
	local dl="$2"
	local up="$3"
	local ip4="$4"
	local ip6="$5"
	local mac="$6"
	local dev="${7:-$DEV_DEFAULT}"
	local total_dl="$8"
	local total_up="$9"
	local up_qid dl_qid selector_count

	is_uinteger "$slot" || die "queue slot must be an integer"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	valid_dev "$dev" || die "invalid device name"

	need_nft
	need_qdma_layout

	[ "$slot" -ge 1 ] && [ "$slot" -le "$TC_SLOT_MAX" ] ||
		die "queue slot must be between 1 and $TC_SLOT_MAX"
	[ -n "$ip4" ] && valid_ipv4 "$ip4" || [ -z "$ip4" ] ||
		die "invalid IPv4 selector"
	[ -n "$ip6" ] && valid_ipv6 "$ip6" || [ -z "$ip6" ] ||
		die "invalid IPv6 selector"
	[ -n "$mac" ] && valid_mac "$mac" || [ -z "$mac" ] ||
		die "invalid MAC selector"

	selector_count=0
	[ -z "$ip4" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))
	[ -z "$mac" ] || selector_count=$((selector_count + 1))
	[ "$selector_count" -eq 1 ] ||
		die "exactly one selector is required: IPv4, IPv6, or MAC"

	if [ "$slot" -gt "$QUEUE_SLOTS" ]; then
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$slot" "$up" "$ip4" "$ip6" "$dev" || return 1
		program_tc_queue dl "$slot" "$dl" "$ip4" "$ip6" "$dev" || return 1

		if [ "$up" -ne 0 ]; then
			nft_exception_rule up ip "$ip4" "$dev" || return 1
			nft_exception_rule up ip6 "$ip6" "$dev" || return 1
			nft_exception_rule up ether "$mac" "$dev" || return 1
		fi

		if [ "$dl" -ne 0 ]; then
			nft_exception_rule dl ip "$ip4" "$dev" || return 1
			nft_exception_rule dl ip6 "$ip6" "$dev" || return 1
			nft_exception_rule dl ether "$mac" "$dev" || return 1
		fi

		return 0
	fi

	up_qid="$(queue_from_slot "$slot" up)"
	dl_qid="$(queue_from_slot "$slot" dl)"

	program_queue "$up_qid" "$UP_SCH" "$up"
	program_queue "$dl_qid" "$DL_SCH" "$dl"

	if [ "$up" -ne 0 ]; then
		nft_mark_rule up ip "$ip4" "$up_qid" "$dev" || return 1
		nft_mark_rule up ip6 "$ip6" "$up_qid" "$dev" || return 1
		nft_mark_rule up ether "$mac" "$up_qid" "$dev" || return 1
	fi

	if [ "$dl" -ne 0 ]; then
		nft_mark_rule dl ip "$ip4" "$dl_qid" "$dev" || return 1
		nft_mark_rule dl ip6 "$ip6" "$dl_qid" "$dev" || return 1
		nft_mark_rule dl ether "$mac" "$dl_qid" "$dev" || return 1
	fi
}

add_inferred_rule() {
	local slot="$1"
	local dl="$2"
	local up="$3"
	local selector="$4"
	local dev="${5:-$DEV_DEFAULT}"
	local total_dl="$6"
	local total_up="$7"
	local ip4 ip6 mac

	[ -n "$selector" ] || die "selector is required"

	if valid_ipv4 "$selector"; then
		ip4="$selector"
	elif valid_mac "$selector"; then
		mac="$selector"
	elif valid_ipv6 "$selector"; then
		ip6="$selector"
	else
		die "selector must be an IPv4 address, IPv6 address, or MAC address"
	fi

	add_rule "$slot" "$dl" "$up" "$ip4" "$ip6" "$mac" "$dev" "$total_dl" "$total_up"
}

start_all() {
	local dl="$1"
	local up="$2"
	local dev="${3:-$DEV_DEFAULT}"

	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"
	valid_dev "$dev" || die "invalid device name"

	need_qdma_layout
	set_hnat_bind_threshold
	stop_qos "$dev"
	nft_stop
	start_hnat_qos "$dl" "$up"
	nft_start "$dev" || die "failed to configure nftables"
}

stop_all() {
	local dev="${1:-$DEV_DEFAULT}"

	valid_dev "$dev" || die "invalid device name"

	stop_qos "$dev"
	nft_stop
	stop_hnat_qos
}

usage() {
	cat <<EOF
Usage: $0 <command> [options]

Commands:
  start <download_mbit> <upload_mbit> [dev]
  stop [dev]
  add <slot> <download_kbit> <upload_kbit> <ipv4|ipv6|mac> [dev] [total_down_mbit] [total_up_mbit]

Queue slots 1-31 use the common NETSYS V2/V3 64-QDMA layout. EQoS keeps
qid0 as the default unclassified queue, uses qid1-31 for upload and
qid32-62 for download, and keeps qid63 free for the PPD path. Slots 32
and above use tc software shaping and require an IPv4 or IPv6 selector.
EOF
}

case "$1" in
	start)
		shift
		start_all "$@"
		;;
	stop)
		shift
		stop_all "$@"
		;;
	add)
		shift
		if [ "$#" -le 7 ]; then
			add_inferred_rule "$@"
		else
			add_rule "$@"
		fi
		;;
	*)
		usage
		exit 1
		;;
esac
